# Production Web Deployment
# Used when building for deployment to xergiz.com/products/text-hunter/

# Base path for production web deployment
VITE_BASE_PATH=/products/text-hunter/

# API base URL - full URL for production web API
VITE_API_URL=https://api.xergiz.com/text-hunter

# Supabase — same project as xergiz.com (session is shared via localStorage on same domain)
# Anon key: copy from D:\Code\xergiz\frontend-vue\.env → VITE_SUPABASE_ANON_KEY
VITE_SUPABASE_URL=https://gmrbiqptkwfhtphawdbr.supabase.co
VITE_SUPABASE_ANON_KEY=
